# ------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------
# claude-code    Uses a Claude Pro/Max subscription through the Claude Code
#                harness. No per-token billing; your subscription rate limits
#                apply. Requires CLAUDE_CODE_OAUTH_TOKEN (see README).
# anthropic-api  Uses the Anthropic API with a pay-per-token key. Supports
#                function calling.
# mock           Offline echo backend. Verify a client integration without
#                any credentials.
BACKEND=claude-code

# For BACKEND=claude-code. Generate with:  claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# For BACKEND=anthropic-api.
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------
# Web UI
# ------------------------------------------------------------------
# Leave empty to have one generated on first boot and printed to the logs.
ADMIN_PASSWORD=

# Signs admin session cookies. Generated and persisted if left empty.
SESSION_SECRET=

# ------------------------------------------------------------------
# Behaviour
# ------------------------------------------------------------------
PORT=3000

# User the process drops to, and owner applied to the mounted volumes.
# 1000:1000 suits a plain Docker host; Unraid wants 99:100 (nobody:users).
PUID=1000
PGID=1000
DEFAULT_MODEL=claude-opus-5

# Ceiling on max_tokens a client may request.
MAX_TOKENS_LIMIT=64000
# Used when the client sends no max_tokens.
DEFAULT_MAX_TOKENS=16000

# Reasoning effort: low | medium | high | xhigh | max. Empty = API default.
# Clients can override per request with OpenAI's reasoning_effort field.
DEFAULT_EFFORT=

# Return Claude's summarised thinking as `reasoning_content`. Costs extra
# output tokens; most OpenAI clients ignore the field.
EXPOSE_THINKING=false

# Require an API key on /v1. Only disable on a trusted private network.
REQUIRE_AUTH=true

# Set true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Days of request history to keep. 0 disables pruning.
LOG_RETENTION_DAYS=30

# Serve the admin UI at /admin.
ENABLE_WEB_UI=true
